<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy для Docmost.
  Разворачивается в физический каталог сайта (например C:\inetpub\docmost-proxy).
  Сам сайт, пул и разрешения серверных переменных создаёт setup-windows-host.ps1.
-->
<configuration>
  <system.webServer>

    <!--
      WebSocket здесь намеренно НЕ настраивается: секция system.webServer/webSocket
      заблокирована на уровне сервера (overrideMode=Deny), и там уже enabled="true".
      Именно это нужно real-time редактору Docmost — без проксирования Upgrade
      редактор молча уходит в read-only.
    -->

    <security>
      <requestFiltering>
        <!-- вложения в вики могут быть крупными: 500 МБ -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>

    <rewrite>
      <rewriteMaps>
        <rewriteMap name="MapProto" defaultValue="http">
          <add key="on" value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>

      <rules>
        <!-- ACME HTTP-01 challenge обслуживает сам IIS, не проксируем.
             Нужно, когда появится домен и сертификат Let's Encrypt. -->
        <rule name="ACME challenge passthrough" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>

        <rule name="Proxy to Docmost" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapProto:{HTTPS}}" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <!--
              ARR по умолчанию пишет в X-Forwarded-For "IP:порт", а Docmost
              сохраняет это значение в колонку типа inet -> логин падает с 500
              и PostgresError 22P02 (invalid input syntax for type inet).
              Через localhost:3000 при этом всё работает, поэтому симптом
              легко списать на что-то другое. Отдаём чистый IP без порта.
            -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>
          <action type="Rewrite" url="http://localhost:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
